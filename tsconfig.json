{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext",
		"types": [
			"mocha",
			"node"
		]
	},
	"exclude": [
		"./dist"
	],
	"include": [
		"./src"
	],
	"ts-node": {
		"esm": true,
		"files": true
	}
}
