  "repository": {
    "type": "git",
    "url": "git+https://github.com/1mill/cloudevents.git"
  },
  "dependencies": {
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.12.4",
    "@types/sinon": "^21.0.1",
    "@types/sinon-chai": "^4.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "sinon": "^22.0.0",
    "sinon-chai": "^4.0.1",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
